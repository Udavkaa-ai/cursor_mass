<?xml version="1.0" encoding="utf-8"?>
<!-- Green glass pill: session start -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#382ED87A"
                android:endColor="#152ED87A"
                android:angle="270"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#662ED87A"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</layer-list>
