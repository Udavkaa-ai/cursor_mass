<?xml version="1.0" encoding="utf-8"?>
<!-- Primary button: flat blue→violet gradient, no sheen/stroke -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4A6ED4"
                android:endColor="#6E46C4"
                android:angle="0"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#5E8BFF"
                android:endColor="#8E5CF6"
                android:angle="0"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</selector>
