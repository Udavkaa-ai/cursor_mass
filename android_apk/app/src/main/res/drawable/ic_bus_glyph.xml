<?xml version="1.0" encoding="utf-8"?>
<!-- Compact bus glyph for the in-app logo. Wheels drawn first (behind the
     body) so only their lower arcs peek out below the bumper. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="40"
    android:viewportHeight="40">

    <!-- Wheels (behind the body) -->
    <path
        android:fillColor="#191D3A"
        android:pathData="M7.8,33 a3.1,3.1 0 1 0 6.2,0 a3.1,3.1 0 1 0 -6.2,0 Z"/>
    <path
        android:fillColor="#191D3A"
        android:pathData="M26,33 a3.1,3.1 0 1 0 6.2,0 a3.1,3.1 0 1 0 -6.2,0 Z"/>

    <!-- Body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10,4 h20 a6,6 0 0 1 6,6 v17 a6,6 0 0 1 -6,6 h-20 a6,6 0 0 1 -6,-6 v-17 a6,6 0 0 1 6,-6 Z"/>

    <!-- Windshield -->
    <path
        android:fillColor="#232B58"
        android:pathData="M10.5,9 h19 a2.5,2.5 0 0 1 2.5,2.5 v6 a2.5,2.5 0 0 1 -2.5,2.5 h-19 a2.5,2.5 0 0 1 -2.5,-2.5 v-6 a2.5,2.5 0 0 1 2.5,-2.5 Z"/>

    <!-- Headlights -->
    <path
        android:fillColor="#8E9BFF"
        android:pathData="M9,26.5 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 Z"/>
    <path
        android:fillColor="#8E9BFF"
        android:pathData="M27,26.5 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 Z"/>
</vector>
