<?xml version="1.0" encoding="utf-8"?>
<!-- Widget glass body: full-bleed (no fake shadow — launchers shade widgets
     themselves, and an offset shadow layer reads as a dirty edge on wallpaper) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#D41A1E38"
                android:endColor="#E60D0F1F"
                android:angle="150"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <!-- Sheen: white top reflection -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#26FFFFFF"
                android:endColor="#02FFFFFF"
                android:angle="270"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <!-- Hairline light edge -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#38FFFFFF"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>
