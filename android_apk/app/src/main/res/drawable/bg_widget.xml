<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft drop shadow -->
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#4A000000"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <!-- Glass body: indigo-tinted translucent -->
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#D41A1E38"
                android:endColor="#E60D0F1F"
                android:angle="150"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <!-- Sheen: white top reflection -->
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#26FFFFFF"
                android:endColor="#02FFFFFF"
                android:angle="270"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <!-- Hairline light edge -->
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#38FFFFFF"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
</layer-list>
