<?xml version="1.0" encoding="utf-8"?>
<!-- Widget body: NEAR-TRANSPARENT flat tint so wallpaper shows through.
     Rows float as their own cards (bg_widget_row). Literal colors on purpose —
     widget layouts must not flip with launcher night mode. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2E0E1122"/>
    <stroke android:width="1dp" android:color="#21FFFFFF"/>
    <corners android:radius="24dp"/>
</shape>
