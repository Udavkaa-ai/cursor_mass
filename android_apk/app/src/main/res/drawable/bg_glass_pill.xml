<?xml version="1.0" encoding="utf-8"?>
<!-- Flat pill for small header buttons -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surfacePillPressed"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surfacePill"/>
            <stroke android:width="1dp" android:color="@color/surfaceCardStroke"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</selector>
