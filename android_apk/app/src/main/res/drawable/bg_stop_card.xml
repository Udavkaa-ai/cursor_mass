<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass card: translucent fill + top sheen + hairline light edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#17FFFFFF"
                android:endColor="#0AFFFFFF"
                android:angle="270"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#1CFFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#26FFFFFF"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
