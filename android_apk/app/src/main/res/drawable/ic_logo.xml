<?xml version="1.0" encoding="utf-8"?>
<!-- In-app logo: gradient rounded square + bus glyph -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#5E8BFF"
                android:endColor="#8E5CF6"
                android:angle="315"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#38FFFFFF"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp"
        android:drawable="@drawable/ic_bus_glyph"/>
</layer-list>
