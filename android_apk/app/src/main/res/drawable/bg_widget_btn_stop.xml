<?xml version="1.0" encoding="utf-8"?>
<!-- Widget stop button: red glass pill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#59FF5A6E"
                android:endColor="#2EFF5A6E"
                android:angle="270"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#73FF5A6E"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</layer-list>
