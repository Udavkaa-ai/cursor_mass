<?xml version="1.0" encoding="utf-8"?>
<!-- App background: theme-aware base with two very soft "aurora" glows.
     Colors come from values/colors.xml + values-night/colors.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="@color/appBgStart"
                android:centerColor="@color/appBgCenter"
                android:endColor="@color/appBgEnd"
                android:angle="270"/>
        </shape>
    </item>
    <!-- Violet glow, top-left -->
    <item android:top="-220dp" android:left="-180dp" android:right="60dp" android:bottom="380dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:startColor="@color/glowViolet"
                android:endColor="#008E5CF6"/>
        </shape>
    </item>
    <!-- Blue glow, mid-right -->
    <item android:top="120dp" android:left="120dp" android:right="-200dp" android:bottom="-80dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:startColor="@color/glowBlue"
                android:endColor="#005E8BFF"/>
        </shape>
    </item>
</layer-list>
