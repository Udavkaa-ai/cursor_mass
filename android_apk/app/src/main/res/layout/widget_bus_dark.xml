<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- Header: live dot + stop name + timer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp">

        <TextView
            android:id="@+id/tw_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textSize="8sp"
            android:textColor="@color/w_text2" android:shadowColor="@color/w_shadow" android:shadowRadius="3" android:shadowDy="1"/>

        <TextView
            android:id="@+id/tw_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.07"
            android:textColor="@color/w_text2" android:shadowColor="@color/w_shadow" android:shadowRadius="3" android:shadowDy="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="5dp"/>

        <TextView
            android:id="@+id/tw_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="@color/w_accent" android:shadowColor="@color/w_shadow" android:shadowRadius="3" android:shadowDy="1"
            android:fontFamily="monospace"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Idle: start button -->
    <FrameLayout
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_idle_art"
        android:clipToOutline="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/art_widget_idle"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="14dp"
            android:text="▶  Где автобус?"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/w_on_art" android:shadowColor="@color/w_shadow_art" android:shadowRadius="4" android:shadowDy="1"/>

    </FrameLayout>

    <!-- Active: arrival row 1 -->
    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_widget_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/r1_route"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/w_on_button"
                android:background="@drawable/bg_widget_route"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"/>

        <TextView
            android:id="@+id/r1_dir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="9sp"
            android:textColor="@color/w_text2" android:shadowColor="@color/w_shadow" android:shadowRadius="3" android:shadowDy="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingEnd="4dp"/>

        <TextView
            android:id="@+id/r1_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/w_text2" android:shadowColor="@color/w_shadow" android:shadowRadius="3" android:shadowDy="1"/>
    </LinearLayout>

    <!-- Active: arrival row 2 -->
    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_widget_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/r2_route"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/w_on_button"
                android:background="@drawable/bg_widget_route"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"/>

        <TextView
            android:id="@+id/r2_dir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="9sp"
            android:textColor="@color/w_text2" android:shadowColor="@color/w_shadow" android:shadowRadius="3" android:shadowDy="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingEnd="4dp"/>

        <TextView
            android:id="@+id/r2_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/w_text2" android:shadowColor="@color/w_shadow" android:shadowRadius="3" android:shadowDy="1"/>
    </LinearLayout>

    <!-- Active: arrival row 3 -->
    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_widget_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/r3_route"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/w_on_button"
                android:background="@drawable/bg_widget_route"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"/>

        <TextView
            android:id="@+id/r3_dir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="9sp"
            android:textColor="@color/w_text2" android:shadowColor="@color/w_shadow" android:shadowRadius="3" android:shadowDy="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingEnd="4dp"/>

        <TextView
            android:id="@+id/r3_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/w_text2" android:shadowColor="@color/w_shadow" android:shadowRadius="3" android:shadowDy="1"/>
    </LinearLayout>

    <!-- Active: arrival row 4 -->
    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_widget_row"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/r4_route"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/w_on_button"
                android:background="@drawable/bg_widget_route"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"/>

        <TextView
            android:id="@+id/r4_dir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="9sp"
            android:textColor="@color/w_text2" android:shadowColor="@color/w_shadow" android:shadowRadius="3" android:shadowDy="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingEnd="4dp"/>

        <TextView
            android:id="@+id/r4_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/w_text2" android:shadowColor="@color/w_shadow" android:shadowRadius="3" android:shadowDy="1"/>
    </LinearLayout>

    <!-- Stop button -->
    <Button
        android:id="@+id/btn_stop"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        android:text="СТОП"
        android:textSize="9sp"
        android:letterSpacing="0.08"
        android:textColor="@color/w_stop_text" android:shadowColor="@color/w_shadow" android:shadowRadius="3" android:shadowDy="1"
        android:background="@drawable/bg_widget_btn_stop"
        android:visibility="gone"/>

</LinearLayout>
