<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_accent_strip"
        android:backgroundTint="@color/divider"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        android:text="МЕНЮ"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.14"
        android:textColor="@color/textTertiary"/>

    <TextView
        android:id="@+id/miBackup"
        style="@style/MenuSheetItem"
        android:text="💾   Сохранить бэкап"/>

    <TextView
        android:id="@+id/miRestore"
        style="@style/MenuSheetItem"
        android:text="📂   Восстановить из файла"/>

    <View style="@style/MenuSheetDivider"/>

    <TextView
        android:id="@+id/miAlerts"
        style="@style/MenuSheetItem"
        android:text="🔔   Напоминание о прибытии"/>

    <TextView
        android:id="@+id/miTheme"
        style="@style/MenuSheetItem"
        android:text="🎨   Тема оформления"/>

    <View style="@style/MenuSheetDivider"/>

    <TextView
        android:id="@+id/miAbout"
        style="@style/MenuSheetItem"
        android:text="ℹ️   О приложении"/>

</LinearLayout>
