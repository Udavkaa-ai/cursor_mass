<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_accent_strip"
        android:backgroundTint="@color/divider"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp"
        android:text="📍 ОСТАНОВКИ РЯДОМ"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.14"
        android:textColor="@color/textTertiary"/>

    <TextView
        android:id="@+id/tvNearbyStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="ищу остановки рядом…"
        android:textSize="14sp"
        android:textColor="@color/textSecondary"/>

    <LinearLayout
        android:id="@+id/nearbyList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

    <View style="@style/MenuSheetDivider"/>

    <TextView
        android:id="@+id/miMapSearch"
        style="@style/MenuSheetItem"
        android:text="🗺   Искать на карте"/>

</LinearLayout>
